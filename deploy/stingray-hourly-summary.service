[Unit]
Description=Stingray hourly air-quality summary (local Ollama model)
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=oneshot
User=monusr
Group=monusr
WorkingDirectory=/opt/stingray/current
EnvironmentFile=-/etc/stingray/telegram.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stingray/current/.venv/bin/python -m stingray.summary_job --config /opt/stingray/current/config/application.combined.yaml
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target

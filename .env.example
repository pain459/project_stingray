# Stingray environment variables
# Copy to .env and fill in real values. Never commit .env.

# Mode: mock | hardware
STINGRAY_MODE=mock

# API
STINGRAY_API_HOST=0.0.0.0
STINGRAY_API_PORT=8080

# Database
STINGRAY_DB_PATH=/var/lib/stingray/stingray.db

# Telegram (leave blank to disable alerts)
STINGRAY_TELEGRAM_BOT_TOKEN=
STINGRAY_TELEGRAM_CHAT_ID=

# Timezone for user-facing display (storage is always UTC)
STINGRAY_DISPLAY_TZ=Asia/Kolkata
